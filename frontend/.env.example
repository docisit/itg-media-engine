# ===========================================================
# Frontend .env.example — Next.js Configuration
# ===========================================================
# Copy to .env.local and fill in:
#   cp .env.example .env.local
# NEVER commit .env.local or .env.production to git!
#
# If running with docker-compose.dev.yml, these are set automatically
# — you don't need to create this file. Only needed for manual setup.
# ===========================================================

# ---- API URLs ----
# Where the Django backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- LiveKit (WebRTC) ----
# WebSocket URL — browsers connect here for real-time video/audio
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# HTTP API URL — server-side calls (token generation, room management)
NEXT_PUBLIC_LIVEKIT_API_URL=http://localhost:7880

# Server-side LiveKit credentials (only used in API routes, NEVER exposed to browser)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ---- NextAuth.js ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret
# Generate with: openssl rand -base64 32

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Get from https://dash.cloudflare.com/?to=:turnstile
# Leave blank to disable Turnstile (not recommended for production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Optional: RTMP URLs (for OBS / guest streaming) ----
# Only needed if you're using RTMP alongside WebRTC
# NEXT_PUBLIC_RTMP_SERVER_URL=rtmp://localhost:1936
# NEXT_PUBLIC_LIVEKIT_WS_URL=wss://vdo.yourdomain.com

# ---- Production URLs (override these when deploying) ----
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_LIVEKIT_URL=wss://vdo.yourdomain.com
# NEXTAUTH_URL=https://yourdomain.com