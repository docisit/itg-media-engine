# ===========================================================
# .env.example — Public template for MediaSite configuration
# ===========================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env or .env.docker to git!

# ---- Django ----
DJANGO_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL ----
DATABASE_URL=postgres://youruser:yourpassword@localhost:5432/media_db

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# ---- LiveKit (get keys from your LiveKit instance) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880

# ---- Internal Security ----
INTERNAL_API_SECRET=change-me-to-a-random-hex-string

# ---- Admin ----
ADMIN_URL=admin/
ADMIN_IP_WHITELIST=127.0.0.1

# ---- Frontend URLs ----
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_API_URL=http://localhost:7880

# ---- Email (optional for dev) ----
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# ---- RTMP ----
RTMP_SERVER_URL=rtmp://localhost:1935
RTMP_INGEST_APPLICATION=ingest
RTMP_LIVE_APPLICATION=live
RTMP_GUEST_STREAM_PREFIX=guest_
RTMP_OBS_STREAM_NAME=obs
RTMP_COMPOSED_STREAM_NAME=composed

# ---- Social Streaming Keys (optional) ----
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
FACEBOOK_RTMP_URL=rtmp://live-api-s.facebook.com:80/rtmp
TIKTOK_RTMP_URL=rtmp://live.tiktok.com/live

# ---- Feature Flags ----
SPORTS_MODULE_ENABLED=False

# ---- Turnstile (Cloudflare CAPTCHA) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Node Auth (for NextAuth.js) ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret
