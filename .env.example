# ===========================================================
# .env.example — MediaSite Backend Configuration
# ===========================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env, .env.production, or .env.docker to git!
#
# For WebRTC to work, LiveKit must be running and reachable at
# the LIVEKIT_URL below. See docker-compose.yaml for the LiveKit stack.
# ===========================================================

# ---- Django ----
#DJANGO_ENV=development                   # development | production
SECRET_KEY=change-me-to-a-random-secret-key
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ---- PostgreSQL ----
# Leave blank to use SQLite for local dev (no PostgreSQL needed)
DATABASE_URL=postgres://youruser:yourpassword@localhost:5432/media_db

# ---- Redis (required for WebSockets + LiveKit channels) ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# ---- LiveKit (required for WebRTC guest video/audio) ----
# Get keys from cloud.livekit.io or your self-hosted LiveKit instance
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# WebSocket URL — LiveKit clients connect here:
LIVEKIT_URL=ws://localhost:7880
# HTTP API URL — Django calls this for room management:
LIVEKIT_API_URL=http://localhost:7880

# ---- Internal Security ----
# Random hex string used to secure internal API calls (agent ↔ backend)
INTERNAL_API_SECRET=change-me-to-a-random-hex-string

# ---- Admin ----
# Change the admin URL path to hide it from bots
ADMIN_URL=admin/
# Comma-separated IPs allowed to access /admin/ (leave empty to disable IP check)
ADMIN_IP_WHITELIST=127.0.0.1

# ---- Frontend URLs ----
# Where your Next.js frontend is served (used for CORS, email links, redirects)
FRONTEND_URL=http://localhost:3000

# ---- Email (optional for dev — uses console backend by default) ----
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ---- RTMP (for OBS stream output and guest composition) ----
RTMP_SERVER_URL=rtmp://localhost:1935
RTMP_INGEST_APPLICATION=ingest
RTMP_LIVE_APPLICATION=live
RTMP_GUEST_STREAM_PREFIX=guest_
RTMP_OBS_STREAM_NAME=obs
RTMP_COMPOSED_STREAM_NAME=composed

# ---- Social Streaming Keys ----
# Fill in to enable simulcast to these platforms
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
FACEBOOK_RTMP_URL=rtmp://live-api-s.facebook.com:80/rtmp
TIKTOK_RTMP_URL=rtmp://live.tiktok.com/live

# ---- Feature Flags ----
SPORTS_MODULE_ENABLED=False

# ---- Turnstile (Cloudflare CAPTCHA — optional, leave blank to disable) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- NextAuth.js (used by the frontend) ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret